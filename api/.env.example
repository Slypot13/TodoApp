# Copier en .env (jamais commité) puis adapter.
# Base locale lancée avec `docker compose up -d` à la racine du dépôt.
DATABASE_URL=postgres://todo:todo@localhost:5432/todo
TEST_DATABASE_URL=postgres://todo:todo@localhost:5432/todo_test

# Port d'écoute (Scalingo le fournit automatiquement en production).
PORT=3000

# Origines autorisées à appeler l'API, séparées par des virgules.
CORS_ORIGINS=http://localhost:5173

# Facultatif : forcer (true) ou désactiver (false) le TLS vers PostgreSQL.
# Par défaut, déduit du paramètre sslmode de l'URL.
# DATABASE_SSL=false
